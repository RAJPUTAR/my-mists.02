      const h=setting("homepage");$("hero-eyebrow").value=h.eyebrow;$("hero-title").value=h.title;$("hero-copy").value=h.copy;$("hero-cta").value=h.cta;$("featured-title").value=h.featuredTitle;$("preview-eyebrow").textContent=h.eyebrow;$("preview-title").textContent=h.title;$("preview-copy").textContent=h.copy;$("preview-cta").textContent=h.cta;$("preview-featured").textContent=h.featuredTitle;$("featured-names").textContent="Selected: "+(products.filter(p=>p.featured).map(p=>p.name).join(", ")||"None");
      $("wa-number").value=setting("whatsapp").number;let sh=setting("shipping");$("shipping-fee").value=sh.fee;$("free-threshold").value=sh.threshold;$("shipping-window").value=sh.window;iconRefresh()
    }
    function page(name){activePage=name;document.querySelectorAll(".page").forEach(x=>x.classList.toggle("active",x.id==="page-"+name));document.querySelectorAll(".nav-btn").forEach(x=>x.classList.toggle("active",x.dataset.page===name));$("top-title").textContent=({overview:"Overview",orders:"Orders",products:"Products",customers:"Customers",reviews:"Reviews",coupons:"Coupons & offers",homepage:"Homepage",settings:"Settings",production:"Production setup"})[name];$("sidebar").classList.remove("show");$("mobile-menu").setAttribute("aria-expanded","false");window.scrollTo({top:0,behavior:"smooth"})}
    const fields={
      product:[["name","Product name","text",true],["category","Category","text",true],["price10","10 ml price (₹)","number",true],["price20","20 ml price (₹)","number",true],["stock","Stock status","select","In stock|Low stock|Out of stock"],["notes","Fragrance notes","text",false],["image","Product image HTTPS URL","url",false],["featured","Featured collection","checkbox"],["bestseller","Bestseller","checkbox"]],
      order:[["number","Order reference","text",true],["customer","Customer display name (demo only)","text",true],["items","Items and sizes","text",true],["total","Total (₹)","number",true],["status","Status","select","New|Packing|Shipped|Delivered|Cancelled"]],
      review:[["author","Reviewer display name (demo only)","text",true],["product","Product","text",true],["rating","Rating (1–5)","number",true],["text","Review text","text",true],["status","Moderation status","select","Pending|Approved|Rejected"]],
      coupon:[["code","Coupon code","text",true],["discount","Discount (%)","number",true],["minimum","Minimum order (₹)","number",true],["active","Active","checkbox"]]
    };
    function openModal(type,item){mode=type;editing=item||null;$("modal-title").textContent=(item?"Edit ":"Add ")+type;$("modal-fields").innerHTML=fields[type].map(([key,label,kind,extra])=>{const val=item?.[key]??"";if(kind==="checkbox")return `<label class="check-row wide" for="f-${key}"><input id="f-${key}" type="checkbox" ${val?"checked":""}>${label}</label>`;if(kind==="select")return `<div><label for="f-${key}">${label}</label><select id="f-${key}" class="canva-dropdown">${extra.split("|").map(v=>`<option ${v===val?"selected":""}>${v}</option>`).join("")}</select></div>`;return `<div class="${key==="notes"||key==="image"||key==="text"?"wide":""}"><label for="f-${key}">${label}</label><input id="f-${key}" class="canva-input" type="${kind}" ${kind==="number"?'min="0"':""} ${extra===true?"required":""} value="${esc(val)}"></div>`}).join("");$("editor-backdrop").classList.add("show");$("modal-fields").querySelector("input:not([type=checkbox])")?.focus()}
    function closeModal(){$("editor-backdrop").classList.remove("show");editing=null}
    document.addEventListener("click",async e=>{const b=e.target.closest("button");if(!b)return;
      if(b.dataset.page)page(b.dataset.page);if(b.dataset.goto)page(b.dataset.goto);if(b.dataset.add)openModal(b.dataset.add);
      if(b.dataset.edit)openModal(b.dataset.edit,entries(b.dataset.edit).find(x=>x.id===b.dataset.id));
      if(b.dataset.delete){if(b.dataset.confirm!=="yes"){b.dataset.confirm="yes";b.textContent="Confirm?";setTimeout(()=>{if(b.isConnected&&b.dataset.confirm==="yes"){b.dataset.confirm="";b.textContent="Delete"}},3500);return}const item=entries(b.dataset.delete).find(x=>x.id===b.dataset.id);if(item)await remove(b.dataset.delete,item,b)}
      if(b.dataset.review){const r=entries("review").find(x=>x.id===b.dataset.review);if(r){const copy={...r,status:b.dataset.value};await commit("review",copy,b)}}
      if(b.dataset.whatsapp){const o=entries("order").find(x=>x.id===b.dataset.whatsapp);if(o){const number=setting("whatsapp").number.replace(/\D/g,"");const text=`MY MISTS order ${o.number}\nCustomer: ${o.customer}\nItems: ${o.items}\nTotal: ${money(o.total)}\nStatus: ${o.status}${o.id.startsWith("demo-")?"\nDEMO ORDER — NOT A REAL PURCHASE":""}`;window.open("https://wa.me/"+number+"?text="+encodeURIComponent(text),"_blank","noopener,noreferrer")}}
    });
    document.addEventListener("change",async e=>{if(e.target.dataset.statusId){const o=entries("order").find(x=>x.id===e.target.dataset.statusId);if(!o)return;const old=o.status,updated={...o,status:e.target.value};e.target.disabled=true;if(!await commit("order",updated,null)){e.target.value=old}e.target.disabled=false}});
    $("entity-form").addEventListener("submit",async e=>{e.preventDefault();const item=editing?{...editing}:{id:"item-"+Date.now()+"-"+Math.random().toString(36).slice(2,7)};fields[mode].forEach(([key,,kind])=>{const el=$("f-"+key);item[key]=kind==="checkbox"?el.checked:kind==="number"?Number(el.value):el.value.trim()});if(mode==="product"&&item.image&&!/^https:\/\//i.test(item.image)){toast("Use an HTTPS image URL.");return}if(mode==="review"&&(item.rating<1||item.rating>5)){toast("Rating must be between 1 and 5.");return}if(mode==="coupon"&&(item.discount<0||item.discount>100)){toast("Discount must be from 0 to 100%.");return}if(await commit(mode,item,$("save-entity")))closeModal()});
    async function saveSetting(type,payload,button){const row=rows.find(r=>r.entity_type===type);return commit(type,{id:type,...payload,_row:row},button)}
    $("homepage-form").addEventListener("submit",async e=>{e.preventDefault();await saveSetting("homepage",{eyebrow:$("hero-eyebrow").value,title:$("hero-title").value,copy:$("hero-copy").value,cta:$("hero-cta").value,featuredTitle:$("featured-title").value},$("save-homepage"))});
    $("whatsapp-form").addEventListener("submit",async e=>{e.preventDefault();if($("wa-number").value.replace(/\D/g,"").length<10){toast("Enter a valid WhatsApp number.");return}await saveSetting("whatsapp",{number:$("wa-number").value},$("save-whatsapp"))});
    $("shipping-form").addEventListener("submit",async e=>{e.preventDefault();await saveSetting("shipping",{fee:Number($("shipping-fee").value),threshold:Number($("free-threshold").value),window:$("shipping-window").value},$("save-shipping"))});
    ["product","order"].forEach(type=>$(type+"-search").addEventListener("input",render));
    $("enter-demo").addEventListener("click",()=>{$("access-screen").style.display="none";$("admin-app").classList.add("open");render()});
    $("mobile-menu").addEventListener("click",()=>{const open=$("sidebar").classList.toggle("show");$("mobile-menu").setAttribute("aria-expanded",String(open))});
    $("close-modal").addEventListener("click",closeModal);$("cancel-modal").addEventListener("click",closeModal);$("editor-backdrop").addEventListener("click",e=>{if(e.target===$("editor-backdrop"))closeModal()});document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()});
    (async()=>{try{const result=await window.dataSdk.init({onDataChanged(data){rows=data;render()}});ready=result.isOk;if(!ready)toast("Saved controls are unavailable right now.")}catch(e){toast("Saved controls are unavailable right now.")}render()})();
  </script>
 </body>
</html>
