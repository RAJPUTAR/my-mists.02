    async function commit(type,item,button){if(!ready){toast("Saving is unavailable. Please try again later.");return false}if(!item._row&&rows.length>=999){toast("The 999-record limit has been reached.");return false}if(busy){toast("Please wait for the previous change to finish.");return false}busy=true;if(button){button.disabled=true;button.dataset.original=button.textContent;button.textContent="Saving…"}const record={entity_type:type,entity_key:item.id||type,payload:JSON.stringify(Object.fromEntries(Object.entries(item).filter(([k])=>k!=="_row"&&k!=="id"))),updated_at:new Date().toISOString()};let result;try{result=item._row?await window.dataSdk.update({...item._row,...record}):await window.dataSdk.create(record)}catch(e){result={isOk:false}}busy=false;if(button){button.disabled=false;button.textContent=button.dataset.original||"Save"}if(!result.isOk){toast("Could not save this change. Please retry.");return false}if(!item._row){const i=demo[type]?.findIndex(x=>x.id===item.id);if(i>=0)demo[type].splice(i,1)}toast("Saved to the control panel.");return true}
